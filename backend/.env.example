# Backend identity shown by the health-check endpoint.
APP_NAME=E-Commerce Customer Service API
APP_VERSION=0.1.0
# Browser origins allowed to call FastAPI during local development.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional: defaults to backend/data/ecommerce.db even when launched from PyCharm.
# DATABASE_URL=sqlite+aiosqlite:///./data/ecommerce.db
